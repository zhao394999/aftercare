FROM node:26-bookworm-slim AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
RUN npm run build

FROM caddy:2-alpine AS edge

FROM python:3.14.7-slim-trixie
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/backend
WORKDIR /app
COPY backend/requirements.lock backend/requirements.lock
RUN pip install --no-cache-dir -r backend/requirements.lock && groupadd --gid 10001 aftercare && useradd --uid 10001 --gid aftercare --no-create-home aftercare
COPY --from=edge /usr/bin/caddy /tmp/caddy
# Render blocks file capabilities; this service only binds unprivileged ports.
RUN install -m 0755 /tmp/caddy /usr/bin/caddy && rm /tmp/caddy
COPY --from=frontend /build/dist /srv
COPY backend backend
COPY deployment/Caddyfile.railway /etc/caddy/Caddyfile
COPY deployment/render_start.py deployment/render_start.py
COPY deployment/check_storage.py deployment/check_storage.py
USER 10001:10001
EXPOSE 10000
CMD ["python", "deployment/render_start.py"]
