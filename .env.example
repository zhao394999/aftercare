APP_ENV=development
DATABASE_URL=sqlite:///./runtime/aftercare.db
PUBLIC_ORIGIN=http://127.0.0.1:5173
DEMO_MODE=false
COOKIE_SECURE=false
SESSION_HOURS=12
STORAGE_BACKEND=local
STORAGE_DIR=runtime/files
S3_BUCKET=
S3_ENDPOINT=
REDIS_URL=
# Only trusted operators configure model endpoints. Never expose keys in frontend code.
LLM_BASE_URL=
LLM_API_KEY=
LLM_API_KEY_FILE=
LLM_MODEL=
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
LLM_MAX_CALLS=12
LLM_BUDGET_MICROUSD=1000000
LLM_TENANT_DAILY_BUDGET_MICROUSD=10000000
# 0 disables deployment-wide limit; nonzero persists across tenants and restarts.
LLM_TOTAL_BUDGET_MICROUSD=0
OTEL_EXPORTER_OTLP_ENDPOINT=
# Feishu Base automation. One trusted table and ticket owner per deployment.
# Generate a random token with at least 32 characters; keep it out of table cells.
FEISHU_INTAKE_TOKEN=
FEISHU_TENANT_ID=
FEISHU_OWNER_ID=
FEISHU_BASE_ID=
FEISHU_TABLE_ID=

# Kuaidi100 real-time query; prefer a protected key file. Never send these to the browser.
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=
KUAIDI100_KEY_FILE=
